<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Home.master.cs" Inherits="website_tin_tuc.Home" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <title>Tech Notes</title>
    <link href="theme/Styles.css?v=20260612-13" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="Home" runat="server">
        <div id="menutop">
            <div id="menu">
                <ul>
                    <li><a href="index.aspx">Trang chủ</a> </li>
                    <li><a href="About.aspx">Giới thiệu</a> </li>
                    <asp:Repeater ID="rpBanTin" runat="server">
                        <ItemTemplate>
                            <li><a href="bantin.aspx?idbantin=<%# Eval("IDBanTin") %>"><%# Eval("tenBanTin") %></a></li>
                        </ItemTemplate>
                    </asp:Repeater>
                    <%
                        bool isAdmin = Session["admin"] != null && (bool)Session["admin"];
                        bool isLoggedIn = Session["isLoggedIn"] != null && (bool)Session["isLoggedIn"];
                        if (!isLoggedIn)
                        {
                        %>
                            <li><a href="login.aspx">Đăng nhập</a> </li>
                            <li><a href="dangky.aspx">Đăng ký</a> </li>
                    <%
                        }
                        else
                        {
                        %>
                            <li class="menu-dropdown">
                                <a href="#">Tài khoản</a>
                                <ul class="submenu">
                                    <li><a href="ChangePassword.aspx">Đổi mật khẩu</a></li>
                    <%
                            if (isAdmin)
                            {
                    %>
                                    <li><a href="AdminPosts.aspx">Quản lý bài viết</a></li>
                                    <li><a href="ChiTietAdd.aspx">Thêm bài viết</a></li>
                    <%
                            }
                    %>
                                    <li><a href="logout.aspx">Thoát</a></li>
                                </ul>
                            </li>
                    <%} %>
                </ul>
            </div>
           </div>
           <div id="maincontent">
               <div id="rightcontent">
                   <h1>Tài nguyên học tập</h1>
                   <div id="ndright">
                       <ul class="resource-list">
                          <li>
                              <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" rel="noopener">
                                  <span class="resource-index">01</span>
                                  <span class="resource-title">ASP.NET Core Docs</span>
                                  <span class="resource-desc">Tài liệu chính thức về ASP.NET Core, Web API và Razor.</span>
                              </a>
                          </li>
                          <li>
                              <a href="https://developer.mozilla.org/" target="_blank" rel="noopener">
                                  <span class="resource-index">02</span>
                                  <span class="resource-title">MDN Web Docs</span>
                                  <span class="resource-desc">HTML, CSS, JavaScript và kiến thức nền tảng web.</span>
                              </a>
                          </li>
                          <li>
                              <a href="https://learn.microsoft.com/sql/" target="_blank" rel="noopener">
                                  <span class="resource-index">03</span>
                                  <span class="resource-title">SQL Server Docs</span>
                                  <span class="resource-desc">Truy vấn, tối ưu database và quản trị SQL Server.</span>
                              </a>
                          </li>
                          <li>
                              <a href="https://docs.docker.com/" target="_blank" rel="noopener">
                                  <span class="resource-index">04</span>
                                  <span class="resource-title">Docker Docs</span>
                                  <span class="resource-desc">Container, image, compose và triển khai ứng dụng.</span>
                              </a>
                          </li>
                          <li>
                              <a href="https://roadmap.sh/" target="_blank" rel="noopener">
                                  <span class="resource-index">05</span>
                                  <span class="resource-title">roadmap.sh</span>
                                  <span class="resource-desc">Lộ trình học Web, Backend, DevOps và nhiều hướng công nghệ khác.</span>
                              </a>
                          </li>
                    </ul>
                   </div>
               </div>
               <div id="content">
                   
               
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">

            </asp:ContentPlaceHolder>
        </div>
    </div>
        <div id="footer">
            <div id="ndfooter">
                &copy; Dương Quang Thịnh. <br />
                Liên hệ trực tuyến qua Email: dqthinhdq03@gmail.com
                Với Hotline: 0869641679
            </div>
        </div>
        <div id="deleteConfirmOverlay" class="confirm-overlay">
            <div class="confirm-dialog">
                <h2>Xác nhận xóa</h2>
                <p id="deleteConfirmMessage">Bạn chắc chắn muốn xóa mục này?</p>
                <div class="confirm-actions">
                    <button type="button" class="confirm-cancel" onclick="closeDeleteConfirm()">Hủy</button>
                    <button type="button" class="confirm-delete" onclick="confirmDeleteAction()">Xóa</button>
                </div>
            </div>
        </div>
        <script>
            var pendingDeleteElement = null;

            function showDeleteConfirm(element, message) {
                if (element.getAttribute("data-confirmed") === "1") {
                    element.removeAttribute("data-confirmed");
                    return true;
                }

                pendingDeleteElement = element;
                document.getElementById("deleteConfirmMessage").innerText = message || "Bạn chắc chắn muốn xóa mục này?";
                document.getElementById("deleteConfirmOverlay").className = "confirm-overlay is-open";
                return false;
            }

            function closeDeleteConfirm() {
                pendingDeleteElement = null;
                document.getElementById("deleteConfirmOverlay").className = "confirm-overlay";
            }

            function confirmDeleteAction() {
                if (pendingDeleteElement) {
                    pendingDeleteElement.setAttribute("data-confirmed", "1");
                    pendingDeleteElement.click();
                }
                closeDeleteConfirm();
            }
        </script>
    </form>
</body>
</html>
